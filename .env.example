NODE_ENV=development
APP_PORT=80
API_PORT=3000
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
EMAIL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=http://localhost
APP_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30
DEV_RETURN_ACTION_LINKS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# Meta OAuth (configure after creating the Meta Developer application)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.example/api/integrations/meta/callback
META_GRAPH_API_VERSION=v27.0
META_SCOPES=pages_show_list,pages_read_engagement,read_insights,pages_manage_posts,pages_read_user_content,pages_manage_engagement,instagram_basic,instagram_manage_insights,instagram_content_publish,instagram_manage_comments,ads_read
# Generate a dedicated 32-byte key; do not reuse EMAIL_ENCRYPTION_KEY or AUTH_JWT_SECRET.
META_TOKEN_ENCRYPTION_KEY=

PGHOST=postgres
PGPORT=5432
PGDATABASE=ai_marketing_manager
# Administrative PostgreSQL role used only by database-init and admin-bootstrap.
PGUSER=app_user
PGPASSWORD=
# Restricted role used by the backend at runtime.
APP_DB_USER=ai_marketing_app
APP_DB_PASSWORD=
PG_POOL_MAX=4

REDIS_URL=redis://redis:6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ai-marketing-manager
